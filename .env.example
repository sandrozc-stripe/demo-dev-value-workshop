# Stripe Developer Tools Workshop - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Required for ALL Labs
# ===========================================

# Your Stripe Secret API Key (test mode)
# Get this from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# ===========================================
# Required for Lab 02: Webhook Integration
# ===========================================

# Webhook signing secret
# For local testing: Get this from `stripe listen` output
# For production: Get this from Dashboard > Webhooks > Your Endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# Optional
# ===========================================

# Stripe Publishable Key (if needed for frontend demos)
# STRIPE_PUBLISHABLE_KEY=pk_test_...
